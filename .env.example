# Optional. If set, ResumeForge AI will use this key to call the Anthropic
# API for optional, natural-language-phrased improvement suggestions.
# Everything else (job description parsing, keyword matching, ATS scoring,
# resume tailoring, one-page fitting, and fact-checking) is fully
# deterministic and works with NO key set, using the built-in mock provider.
AI_API_KEY=

# Model to use when AI_API_KEY is set.
AI_MODEL=claude-sonnet-4-5
